# =============================================================================
# Razer AIKit Dockerfile
# =============================================================================
# This Dockerfile builds a production-ready image for Razer AIKit, extending
# the official vLLM image with additional ML tooling, Jupyter integration, and
# custom GPU capabilities.
# =============================================================================

# Build arguments for version pinning
ARG CUDA_BUILD_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu20.04
ARG VLLM_IMAGE=vllm/vllm-openai:v0.14.1

# =============================================================================
# Stage 1: Base Environment Setup
# =============================================================================
# Extends official vLLM image with conda environment and user configuration
FROM ${VLLM_IMAGE} AS base

# Environment configuration
ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129
ENV DEBIAN_FRONTEND=noninteractive

# Install essential system packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        iproute2 \
        net-tools \
        wget && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user with sudo privileges for security
RUN useradd -m -s /bin/bash ${USERNAME} && \
    usermod -aG sudo ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to non-root user for remaining operations
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Configure pip
ENV PIP_NO_CACHE_DIR=true

# Install Miniconda for Python environment management
ENV CONDA_DIR=/home/${USERNAME}/miniconda3
ENV PATH=${CONDA_DIR}/bin:${PATH}

RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O anaconda.sh && \
    bash anaconda.sh -b -p ${CONDA_DIR} && \
    rm anaconda.sh && \
    conda clean -afy

# Initialize and configure conda
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    conda init bash && \
    conda config --add channels defaults && \
    conda update -n base conda -y && \
    conda clean -afy

# Save base environment paths for later restoration
SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate base && \
    echo "base PATH : ${PATH}" && \
    echo "export CONDA_BASE_PATH=${PATH}" >> ~/.bashrc && \
    echo "export CONDA_BASE_LD_LIBRARY_PATH=${LD_LIBRARY_PATH}" >> ~/.bashrc && \
    echo "export CONDA_BASE_LIBRARY_PATH=${LIBRARY_PATH}" >> ~/.bashrc

# Create isolated Python 3.12 environment
RUN conda create -n ${VIRTUAL_ENV} python=3.12 -y && \
    echo "conda activate ${VIRTUAL_ENV}" >> ~/.bashrc

ENV CONDA_VIRTUAL_ENV=${VIRTUAL_ENV}

# Configure Python path to find vLLM distribution packages
RUN echo '/usr/local/lib/python3.12/dist-packages/' > \
    /home/${USERNAME}/miniconda3/envs/${VIRTUAL_ENV}/lib/python3.12/site-packages/vllm.pth

# =============================================================================
# Stage 2: GPU Tools Build
# =============================================================================
# Compiles custom GPU discovery module with CUTLASS support and vLLM plugins
# Uses CUDA development environment for building GPU-accelerated extensions
FROM ${CUDA_BUILD_IMAGE} AS build_gpu_tools

ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129

ENV CONDA_DIR=/home/${USERNAME}/miniconda3

# Copy build dependencies from base stage
COPY gpu_discovery gpu_discovery
COPY --chown=${USERNAME}:${USERNAME} vllm_plugins vllm_plugins
COPY --from=base /home/${USERNAME}/miniconda3 /home/${USERNAME}/miniconda3
COPY --from=base /usr/local/lib/python3.12/ /usr/local/lib/python3.12/

# Build GPU discovery wheel
SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install build && \
    echo 'Building GPU discovery module...' && \
    cd gpu_discovery && \
    export MAX_JOBS=$(nproc) && \
    python -m build --no-isolation --wheel --outdir ../gpu-discovery-dist --verbose && \
    cd .. && \
    pip install gpu-discovery-dist/*.whl --verbose && \
    echo 'GPU discovery module built successfully'

# Build GPU ordering (vLLM plugins) wheel
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    echo 'Building GPU ordering (vLLM plugins)...' && \
    cd vllm_plugins && \
    python -m build --no-isolation --wheel --outdir ../gpu-ordering-dist --verbose && \
    cd .. && \
    pip install gpu-ordering-dist/*.whl --verbose && \
    echo 'GPU ordering (vLLM plugins) built successfully'

# =============================================================================
# Stage 3: Extended vLLM Base
# =============================================================================
# Adds distributed computing, audio processing, and custom tooling to vLLM
FROM base AS vllm_extended

ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129

ENV CUDA_HOME=/usr/local/cuda-12.9
ENV OWNER=${USERNAME}
ENV BASE_WORKDIR=/home/${USERNAME}
ENV CONDA_DIR=${BASE_WORKDIR}/miniconda3

# Install Ray with all optional dependencies for distributed workloads at system level
# NOTE: Ray and vLLM MUST be installed at system level (/usr/bin/python3) instead of conda
# Installing them in conda while vLLM base is in system causes version conflicts and import errors
# Mixed system/conda installations lead to library path conflicts and segmentation faults

SHELL ["/bin/bash", "-c"]
RUN RAY_VERSION=$(/usr/bin/python3 -c "import importlib.metadata; print(importlib.metadata.version('ray'))") && \
    echo "Detected Ray version: ${RAY_VERSION}" && \
    /usr/bin/pip3 install --no-cache-dir "ray[all]==${RAY_VERSION}"

# Install vLLM audio extension for multimodal capabilities at system level
RUN VLLM_VERSION=$(/usr/bin/python3 -c "import importlib.metadata; print(importlib.metadata.version('vllm'))") && \
    echo "Detected vLLM version: ${VLLM_VERSION}" && \
    /usr/bin/pip3 install --no-cache-dir "vllm[audio]==${VLLM_VERSION}"

# Copy operational scripts and benchmarking tools
COPY --chown=${USERNAME}:${USERNAME} docker_build_aikit/scripts/ ${BASE_WORKDIR}/scripts/
COPY --chown=${USERNAME}:${USERNAME} docker_build_aikit/benchmarks/ ${BASE_WORKDIR}/benchmarks/

# Install GPU tools (gpu_discovery + vllm_plugins) from build stage
# NOTE: Installing only to system Python (like vLLM and Ray) for consistency
COPY --from=build_gpu_tools --chown=${USERNAME}:${USERNAME} \
    gpu-discovery-dist ${BASE_WORKDIR}/gpu-discovery-dist
COPY --from=build_gpu_tools --chown=${USERNAME}:${USERNAME} \
    gpu-ordering-dist ${BASE_WORKDIR}/gpu-ordering-dist

# Install to system Python (accessible by Ray workers and conda via .pth file)
RUN /usr/bin/pip3 install ${BASE_WORKDIR}/gpu-discovery-dist/*.whl --verbose && \
    /usr/bin/pip3 install ${BASE_WORKDIR}/gpu-ordering-dist/*.whl --verbose && \
    rm -rf ${BASE_WORKDIR}/gpu-discovery-dist ${BASE_WORKDIR}/gpu-ordering-dist

# Install conda environment hooks
COPY --chown=${USERNAME}:${USERNAME} \
    docker_build_aikit/conda/ ${CONDA_DIR}/envs/${VIRTUAL_ENV}/etc/conda/

ENTRYPOINT ["bash"]

# =============================================================================
# Stage 4: Razer AIKit Package Build
# =============================================================================
# Builds the core rzr-aikit Python wheel for distribution
FROM vllm_extended AS build_rzr_aikit

ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129

ENV OWNER=${USERNAME}
ENV BASE_WORKDIR=/home/${USERNAME}
ENV CONDA_DIR=${BASE_WORKDIR}/miniconda3

# Copy source code
COPY --chown=${OWNER} rzr-aikit ${BASE_WORKDIR}/src

# Build Python wheel using PEP 517 build system
SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install build 'poetry-core>=1.0.0' && \
    cd src && \
    python -m build --no-isolation --wheel --outdir ../rzr-aikit-dist --verbose && \
    echo "rzr-aikit wheel built successfully" && \
    cd .. && \
    pip install rzr-aikit-dist/*.whl --verbose && \
    echo "rzr-aikit wheel installed successfully"

# =============================================================================
# Stage 5: Test (Optional)
# =============================================================================
# Runs rzr-aikit unit tests - can be built standalone for validation
FROM vllm_extended AS test

ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129

ENV OWNER=${USERNAME}
ENV BASE_WORKDIR=/home/${USERNAME}
ENV CONDA_DIR=${BASE_WORKDIR}/miniconda3

# Copy source code for testing
COPY --chown=${OWNER} rzr-aikit ${BASE_WORKDIR}/src

SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    cd src && \
    pip install -e . && \
    pip install pytest pytest-mock && \
    cd tests && \
    pytest model

# =============================================================================
# Stage 6: Jupyter Extension Build
# =============================================================================
# Builds custom Jupyter Lab homepage extension for AIKit interface
FROM build_rzr_aikit AS build_jupyter_extension

COPY --chown=Razer:Razer jupyter_extension /home/Razer/notebooks/jupyter_extension

SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install build jupyterlab hatchling hatch-nodejs-version hatch-jupyter-builder && \
    conda install -y conda-forge::nodejs && \
    echo 'Building Jupyter extension...' && \
    cd notebooks/jupyter_extension && \
    jlpm install && \
    jlpm build:prod && \
    python -m build --no-isolation --wheel --outdir ../../rzr-home-dist --verbose && \
    echo 'Jupyter extension built successfully'

# =============================================================================
# Stage 7: Final Production Image
# =============================================================================
# Clean production image with rzr-aikit, Jupyter, and fine-tuning capabilities
FROM vllm_extended AS rzr-aikit

ARG USERNAME=Razer
ARG VIRTUAL_ENV=torch291_cuda129

ENV OWNER=${USERNAME}
ENV BASE_WORKDIR=/home/${USERNAME}
ENV CONDA_DIR=${BASE_WORKDIR}/miniconda3

USER ${USERNAME}
WORKDIR ${BASE_WORKDIR}

# Install rzr-aikit from build stage
COPY --from=build_rzr_aikit --chown=${OWNER} \
    ${BASE_WORKDIR}/rzr-aikit-dist ${BASE_WORKDIR}/rzr-aikit-dist

SHELL ["/bin/bash", "-c"]
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install ${BASE_WORKDIR}/rzr-aikit-dist/*.whl --verbose && \
    rm -rf ${BASE_WORKDIR}/rzr-aikit-dist

# Install JupyterLab with bash kernel support
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install --no-cache-dir jupyterlab bash_kernel && \
    python -m bash_kernel.install

# Copy Jupyter notebooks
ENV JUPYTER_NOTEBOOK_DIR="${BASE_WORKDIR}/notebooks/"
COPY --chown=${OWNER} notebooks/ "${JUPYTER_NOTEBOOK_DIR}/"

# Install GPU automation CLI utilities
COPY --chown=${OWNER} \
    rzr-aikit/util/gpu_*.py ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/

RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    chmod +x ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu_*.py && \
    ln -s ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu_discover.py \
          ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu-discover && \
    ln -s ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu_select.py \
          ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu-select && \
    ln -s ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu_filter.py \
          ${CONDA_DIR}/envs/${VIRTUAL_ENV}/bin/gpu-filter

# Install LlamaFactory for model fine-tuning
# NOTE: Complex dependency resolution required to maintain compatibility with base image
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    cd ${BASE_WORKDIR} && \
    git clone --depth 1 https://github.com/hiyouga/LLaMA-Factory.git && \
    cd LLaMA-Factory && \
    pip install hatchling && \
    pip install -I \
        "websockets<16.0" \
        "pydantic_core==2.41.4" \
        "pillow==11.3.0" \
        "fsspec==2025.3.0" \
        "dill==0.3.8" \
        "aiofiles==24.1.0" \
        "pydantic==2.12.3" \
        "transformers==4.57.1" \
        "accelerate==1.11.0" && \
    pip install ".[torch,metrics]" --no-build-isolation && \
    pip uninstall -y torch numpy && \
    pip freeze | grep "nvidia-.*-cu12" | xargs pip uninstall -y && \
    pip install --no-cache-dir bitsandbytes && \
    cd .. && \
    rm -rf LLaMA-Factory

# Install custom Jupyter extension
COPY --from=build_jupyter_extension --chown=${OWNER} \
    ${BASE_WORKDIR}/rzr-home-dist ${BASE_WORKDIR}/rzr-home-dist

RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip install ${BASE_WORKDIR}/rzr-home-dist/*.whl --verbose && \
    rm -rf ${BASE_WORKDIR}/rzr-home-dist && \
    jupyter labextension disable @jupyterlab/launcher-extension && \
    mkdir -p ~/.jupyter/lab/user-settings/@jupyterlab/apputils-extension/ && \
    echo '{"theme": "JupyterLab Dark"}' > \
        ~/.jupyter/lab/user-settings/@jupyterlab/apputils-extension/themes.jupyterlab-settings

# Configure environment variables and Ray workarounds
RUN echo "export RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0" >> ~/.bashrc && \
    # Ensures consistent GPU ordering across CUDA operations
    echo "export CUDA_DEVICE_ORDER=PCI_BUS_ID" >> ~/.bashrc && \
    # Disables Ray's log deduplication for better debugging visibility
    echo "export RAY_DEDUP_LOGS=0" >> ~/.bashrc && \
    # Cleans stale Ray cluster metadata on container restart/login
    echo 'pgrep ray > /dev/null || rm -f /tmp/ray/ray_current_cluster' >> ~/.bashrc

# Remove pynvml to suppress PyTorch compatibility warnings
RUN source ${CONDA_DIR}/etc/profile.d/conda.sh && \
    conda activate ${VIRTUAL_ENV} && \
    pip uninstall --yes pynvml

# Default entrypoint provides bash shell for interactive use
ENTRYPOINT ["bash"]
