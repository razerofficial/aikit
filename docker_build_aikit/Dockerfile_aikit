# =============================================================================
# Razer AIKit Dockerfile
# =============================================================================
# This Dockerfile builds a production-ready image for Razer AIKit, extending
# the official vLLM image with additional ML tooling, Jupyter integration, and
# custom GPU capabilities.
# =============================================================================

# TODO: Implement auto-detection of CUDA version from host system
# Build arguments for version pinning
ARG CUDA_VERSION_MAJOR=13
ARG CUDA_VERSION_MINOR=0
ARG VLLM_VERSION=v0.20.0
ARG VLLM_IMAGE=vllm/vllm-openai:$VLLM_VERSION-cu${CUDA_VERSION_MAJOR}${CUDA_VERSION_MINOR}

FROM ${VLLM_IMAGE} AS base
ARG CUDA_VERSION_MAJOR CUDA_VERSION_MINOR
# Environment variables inherited by all dependent stages
ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
ENV UV_NO_CACHE=1
ENV PIP_NO_CACHE_DIR=true
ENV DEBIAN_FRONTEND=noninteractive
# TODO: Implement auto-detection of CUDA installation path
ENV CUDA_HOME=/usr/local/cuda-${CUDA_VERSION_MAJOR}.${CUDA_VERSION_MINOR}
RUN ln -s /usr/bin/python3 /usr/bin/python

# =============================================================================
# Stage 2: GPU Tools Build
# =============================================================================
# Compiles custom GPU discovery module with CUTLASS support and vLLM plugins
# Uses CUDA development environment for building GPU-accelerated extensions
FROM base AS build_gpu_tools
# Using base image instead of CUDA devel image to maintain Python package compatibility
# This approach keeps dependency versions synchronized with the vLLM base image

ARG CUDA_VERSION_MAJOR CUDA_VERSION_MINOR
# Install CUDA development libraries required for building GPU extensions
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends cuda-libraries-dev-${CUDA_VERSION_MAJOR}-${CUDA_VERSION_MINOR} && \
    rm -rf /var/lib/apt/lists/*

# Copy GPU tool source code for compilation
COPY gpu_discovery gpu_discovery
COPY vllm_plugins vllm_plugins

# Build GPU discovery wheel
RUN pip install build && \
    echo 'Building GPU discovery module...' && \
    cd gpu_discovery && \
    # TODO: Verify if MAX_JOBS override is necessary when using Ninja build system
    export MAX_JOBS=$(nproc) && \
    python3 -m build --no-isolation --wheel --outdir ../gpu-discovery-dist --verbose && \
    cd .. && \
    python3 -m pip install gpu-discovery-dist/*.whl --verbose && \
    echo 'GPU discovery module built successfully'

# Build GPU ordering (vLLM plugins) wheel
RUN echo 'Building GPU ordering (vLLM plugins)...' && \
    cd vllm_plugins && \
    python3 -m build --no-isolation --wheel --outdir ../gpu-ordering-dist --verbose && \
    cd .. && \
    python3 -m pip install gpu-ordering-dist/*.whl --verbose && \
    echo 'GPU ordering (vLLM plugins) built successfully'

# =============================================================================
# Stage 3: Extended vLLM Base
# =============================================================================
# Adds distributed computing, audio processing, and custom tooling to vLLM
FROM base AS vllm_extended
ARG VLLM_VERSION

# Install Ray for distributed computing and cluster management
RUN uv pip install --system "ray[all]"

# Install vLLM audio extension for multimodal capabilities at system level
RUN uv pip install --system "vllm[audio]==${VLLM_VERSION}" && \
    uv pip install --system vllm-omni==${VLLM_VERSION}
# Install chafa for terminal-based image rendering
RUN apt-get update && apt-get install -y chafa && rm -rf /var/lib/apt/lists/*

# Copy operational scripts and benchmarking tools
COPY docker_build_aikit/scripts/* /usr/local/bin/
COPY docker_build_aikit/benchmarks/ /var/aikit/benchmarks/

# Install GPU tools (gpu_discovery + vllm_plugins) from build stage
# TODO: Investigate Docker COPY context limitations preventing relative path usage
COPY --from=build_gpu_tools /vllm-workspace/gpu-discovery-dist/ gpu-discovery-dist/
COPY --from=build_gpu_tools /vllm-workspace/gpu-ordering-dist/ gpu-ordering-dist/

RUN uv pip install --system gpu-discovery-dist/*.whl --verbose && \
    uv pip install --system gpu-ordering-dist/*.whl --verbose && \ 
    rm -rf gpu-discovery-dist gpu-ordering-dist

# Copy environment activation scripts for shell session initialization
COPY docker_build_aikit/env-init/activate.d/* /etc/profile.d/

# =============================================================================
# Stage 4: Razer AIKit Install (locked)
# =============================================================================
# Installs rzr-aikit and its dependencies at exact versions from uv.lock
FROM vllm_extended AS build_rzr_aikit

COPY pyproject.toml uv.lock ./
COPY rzr_aikit rzr_aikit/

# Export pinned requirements from lockfile, then install into system Python
RUN uv export --frozen --no-dev --no-hashes -o /tmp/rzr-requirements.txt && \
    uv pip install --system -r /tmp/rzr-requirements.txt && \
    uv pip install --system --no-deps . && \
    echo "rzr-aikit installed at locked versions"

# =============================================================================
# Stage 5: Test (Optional)
# =============================================================================
# Runs rzr-aikit unit tests - build this stage separately for CI/CD validation
FROM vllm_extended AS test

# Copy source code and tests
COPY pyproject.toml uv.lock ./
COPY rzr_aikit rzr_aikit/
COPY tests tests/

# Install at locked versions with dev deps, then run model tests
RUN uv export --frozen --no-hashes --extra dev -o /tmp/rzr-requirements.txt && \
    uv pip install --system -r /tmp/rzr-requirements.txt && \
    uv pip install --system --no-deps . && \
    cd tests && \
    pytest model

# =============================================================================
# Stage 6: Jupyter Extension Build
# =============================================================================
# Builds custom Jupyter Lab homepage extension for AIKit interface
FROM build_rzr_aikit AS build_jupyter_extension

COPY jupyter_extension jupyter_extension

# Switch to bash for Node.js installation script compatibility
SHELL ["/bin/bash", "-c"]
# Install Node.js 24.x from NodeSource repository
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get update && apt-get install -y nodejs && rm -rf /var/cache/apt/archives /var/lib/apt/lists/* && \
    uv pip install --system build jupyterlab hatchling hatch-nodejs-version hatch-jupyter-builder && \
    echo 'Building Jupyter extension...' && \
    cd jupyter_extension && \
    jlpm install && \
    jlpm build:prod && \
    python3 -m build --no-isolation --wheel --outdir ../rzr-home-dist --verbose && \
    echo 'Jupyter extension built successfully'

# =============================================================================
# Stage 7: Final Production Image
# =============================================================================
# Clean production image with rzr-aikit, Jupyter, and fine-tuning capabilities
FROM build_rzr_aikit AS rzr-aikit

# Install JupyterLab with bash kernel support for interactive shell notebooks
RUN uv pip install --system jupyterlab bash_kernel && \
    python3 -m bash_kernel.install

# Create world-writable notebooks directory for multi-user access
RUN mkdir -m 1777 -p /var/aikit/notebooks && chmod 1777 /var/aikit/

# Copy example Jupyter notebooks
COPY --chmod=ugo=rwX notebooks /var/aikit/notebooks

# Install GPU automation CLI utilities
COPY rzr_aikit/utils/gpu_*.py /usr/local/bin/

RUN chmod +x /usr/local/bin/gpu_*.py && \
    ln -s /usr/local/bin/gpu_discover.py \
          /usr/local/bin/gpu-discover && \
    ln -s /usr/local/bin/gpu_select.py \
          /usr/local/bin/gpu-select && \
    ln -s /usr/local/bin/gpu_filter.py \
          /usr/local/bin/gpu-filter

# Install custom Jupyter extension
COPY --from=build_jupyter_extension /vllm-workspace/rzr-home-dist rzr-home-dist

# TODO: Validate system-level JupyterLab settings override behavior
RUN uv pip install --system rzr-home-dist/*.whl --verbose && \
    rm -rf rzr-home-dist && \
    jupyter labextension disable --level system @jupyterlab/launcher-extension && \
    mkdir -p /usr/local/share/jupyter/lab/settings/ && \
    echo '{"@jupyterlab/apputils-extension:themes":{"theme":"JupyterLab Dark"}}' > \
        /usr/local/share/jupyter/lab/settings/overrides.json && \
    echo 'from pathlib import Path\nc.FileContentsManager.preferred_dir = str(Path.home() / "notebooks")' > \
        /usr/local/etc/jupyter/jupyter_lab_config.py

# Ray and CUDA environment configuration
# - RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO: Preserve CUDA_VISIBLE_DEVICES=0 in Ray
# - CUDA_DEVICE_ORDER: Use PCI bus ordering for consistent GPU enumeration
# - RAY_DEDUP_LOGS: Disable log deduplication for debugging clarity
ENV RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0 \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    RAY_DEDUP_LOGS=0

# TODO: Verify if pynvml removal is still necessary with current PyTorch version
# Remove pynvml to suppress PyTorch compatibility warnings
RUN uv pip uninstall --system pynvml

# TODO: Evaluate necessity of git and wget for end-user environments
# Install essential system packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        iproute2 \
        net-tools \
        wget && \
    rm -rf /var/lib/apt/lists/*

# Install LlamaFactory without resolving its dependencies to prevent version downgrades
RUN uv pip install --system "git+https://github.com/hiyouga/LLaMA-Factory.git" && \
    uv pip install --system "gradio>=6.13.0,<7"
ARG USERNAME=Razer
# Create non-root user with sudo privileges for security
# Make the home directory a shared 1777 folder so that --user works
RUN useradd -m -s /bin/bash -d /var/aikit/ ${USERNAME} && \
    usermod -aG sudo ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to non-root user for remaining operations
USER ${USERNAME}:${USERNAME}
WORKDIR /var/aikit
ENV HOME=/var/aikit

# Otherwise permission is wrong on bind mount
# TODO: Investigate UID/GID remapping solution for bind mount permissions
RUN mkdir -m 777 ~/.cache/
RUN touch ~/.hushlogin

# Default entrypoint provides bash shell for interactive use
# Use login shell for /etc/profile scripts. Entrypoint is executed exactly once for Docker.
ENTRYPOINT ["/usr/bin/env"]
CMD ["bash", "-l"]
