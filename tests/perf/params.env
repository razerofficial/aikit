# The single parameter set applied to every model in models.txt.
#
# Written as ': "${VAR:=default}"' so anything already exported in the
# environment wins, e.g.  NUM_PROMPTS=20 ./run_perf.sh
#
# To sweep later, loop run_perf.sh with different values here (or add
# --max-concurrency to CLIENT_EXTRA_ARGS) -- deliberately not built in yet.

# --- container / image ---------------------------------------------------
: "${CONTAINER:=aikit_perf_run}"
: "${IMAGE_TAG:=aikit_perftest}"

# --- vLLM server (passed to /usr/local/bin/start_vllm) -------------------
: "${PORT:=8000}"
: "${MAX_MODEL_LEN:=8192}"
# NOTE: .vllmenv ships MAX_NUM_SEQS=5, which throttles throughput badly.
# start_vllm gives CLI args precedence over .vllmenv, so this wins.
: "${MAX_NUM_SEQS:=256}"
: "${GPU_MEM_UTIL:=0.90}"
: "${TENSOR_PARALLEL_SIZE:=1}"
# .vllmenv also forces VLLM_LOGGING_LEVEL=DEBUG / NCCL_DEBUG=TRACE and
# *clobbers* any exported value, because it is sourced after the env is read.
# Only the CLI flags below can override it.
: "${VLLM_LOG_LEVEL:=INFO}"
: "${NCCL_LOG_LEVEL:=WARN}"
# Verify these against the built image before a long run (needs --gpus all and
# --help=all; see SKILL.md step 1). Checked on vLLM 0.24.0 in razer:aikit:
#   --swap-space            REMOVED upstream -> dropped from this list
#   --disable-log-requests  inverted to --enable-log-requests
: "${SERVER_EXTRA_ARGS:=--trust-remote-code}"

# How long to wait for GET /health after cold start. Large models spend
# minutes in torch.compile / CUDA graph capture on first load.
: "${READY_TIMEOUT_S:=900}"

# --- benchmark client ----------------------------------------------------
# The repo's vendored client, /var/aikit/benchmarks/benchmark_serving, is BROKEN
# against the vLLM in this image (0.24.0): benchmark_dataset.py imports
#   from vllm.transformers_utils.tokenizer import AnyTokenizer, get_lora_tokenizer
# and that module -- plus both symbols -- was removed upstream. It cannot be
# fixed by re-pointing the import.
#
# So the default is vLLM's own maintained equivalent, which is the upstream
# version of the very same script and accepts every flag this kit passes.
# Switch back to the vendored path once the repo's benchmarks are updated.
: "${CLIENT_CMD:=vllm bench serve}"
# : "${CLIENT_CMD:=/var/aikit/benchmarks/benchmark_serving}"

: "${BACKEND:=vllm}"
: "${DATASET_NAME:=sharegpt}"
: "${DATASET_PATH:=/var/aikit/benchmarks/ShareGPT_300_conversations.json}"
# HARD CEILING 300: ShareGPTDataset.sample() walks the 300-conversation file
# once and stops, so a larger value is silently truncated while the result
# JSON still reports whatever you asked for.
: "${NUM_PROMPTS:=200}"
: "${REQUEST_RATE:=inf}"
: "${PERCENTILE_METRICS:=ttft,tpot,itl,e2el}"
: "${METRIC_PERCENTILES:=50,90,99}"
: "${CLIENT_EXTRA_ARGS:=--trust-remote-code --save-detailed}"

# --- teardown ------------------------------------------------------------
# GPU is considered drained once usage returns to within this many MiB of the
# baseline captured at script start.
: "${GPU_DRAIN_SLACK_MIB:=1024}"
: "${GPU_DRAIN_TIMEOUT_S:=180}"
